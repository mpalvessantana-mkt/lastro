NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Gemini (§8.2) — só no servidor. Nunca use NEXT_PUBLIC_ para a chave.
GEMINI_API_KEY=
# Opcional: sobrescreve o modelo padrão (gemini-3.8-flash)
GEMINI_MODEL=
# Opcional: nível de raciocínio (LOW por padrão; HIGH ou PADRAO deixam a chamada ~5× mais lenta)
GEMINI_THINKING=
# "true" desliga a IA; o motor determinístico sustenta a demo sozinho
MODO_SEM_REDE=
